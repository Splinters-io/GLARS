{
 "version": "1.0",
 "updated": "2026-10-29",
 "about": "Inputs for the GLARS Perspective score: how the asker's own jurisdiction changes the risk of data held in another. Treaty facts come from official texts; the weights are GLARS defaults and can be changed in the calculator.",
 "clamp": [
  0.8,
  1.3
 ],
 "factors": {
  "FVEY": {
   "label": "Five Eyes intelligence sharing",
   "explain": "You and the data's jurisdiction are both in the UKUSA (Five Eyes) signals-intelligence partnership, so what one collects can reach the other's agencies, including your own government's.",
   "weight": 1.1,
   "members": [
    "AU",
    "CA",
    "GB",
    "NZ",
    "US"
   ],
   "source": {
    "label": "The Five Eyes: the intelligence alliance of the Anglosphere (UK Defence Journal)",
    "url": "https://ukdefencejournal.org.uk/the-five-eyes-the-intelligence-alliance-of-the-anglosphere/"
   }
  },
  "CLOUD": {
   "label": "CLOUD Act data access agreement",
   "explain": "A CLOUD Act executive agreement lets each country's authorities serve orders directly on the other's providers for serious-crime investigations, without mutual legal assistance.",
   "weight": 1.05,
   "pairs": [
    {
